# Variáveis do frontend. Copie para .env.local e preencha somente com valores reais.
# A chave pública (anon) pode ser exposta no site. Nunca coloque a service_role aqui.

# Projeto Supabase (ainda não configurado)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Modo do site: "demo" (sem cobrança) ou "producao"
SITE_MODE=demo
